          "body": "Docs say export route requires tenant authorization.",
          "facets": {"conflicting_evidence": true},
          "source_refs": [{"type": "doc", "path": "docs/security.md"}]
        },
        {
          "source_type": "code_context",
          "item_type": "code_context",
          "title": "GET /v2/users/export",
          "body": "Code conflicts with docs: export route lacks tenant authorization.",
          "facets": {"conflicting_evidence": true},
          "source_refs": [{"type": "path", "path": "apps/api/users.py:42"}]
        }
      ],
      "expected": {
        "decision": "verify",
        "scanner_only": false,
        "required_trace": ["conflicting_evidence_requires_verification"]
      }
    },
    {
      "id": "unsupported_framework_gather",
      "name": "Unsupported framework",
      "kind": "golden",
      "entries": [
        {
          "source_type": "code_context",
          "item_type": "code_context",
          "title": "Crystal Lucky endpoint",
          "body": "Unsupported framework lucky-web route could not be confidently parsed.",
          "facets": {"unsupported_framework": true, "framework": "lucky"},
          "source_refs": [{"type": "path", "path": "src/actions/export.cr:12"}]
