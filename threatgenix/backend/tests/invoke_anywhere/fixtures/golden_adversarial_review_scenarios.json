{
  "version": "threatgenix_decision_scenarios_v1",
  "scenarios": [
    {
      "id": "clean_app_pass",
      "name": "Clean app",
      "kind": "golden",
      "entries": [
        {
          "source_type": "code_context",
          "item_type": "code_context",
          "title": "GET /health",
          "body": "FastAPI health route with no sensitive data and no scanner findings.",
          "facets": {"framework": "fastapi", "has_sensitive_signals": false},
          "source_refs": [{"type": "path", "path": "apps/api/health.py:10"}]
        }
      ],
      "expected": {
        "decision": "pass",
        "scanner_only": false,
        "required_trace": ["no_scanner_findings_pass"],
        "required_evidence": ["GET /health"]
      }
    },
    {
      "id": "public_pii_export_missing_authz_blocks",
      "name": "Public PII export route missing tenant authorization",
      "kind": "golden",
      "safety_critical": true,
      "entries": [
        {
          "source_type": "scan_finding",
          "item_type": "scanner_finding",
          "title": "Sensitive export route is missing authorization",
          "body": "severity=high missing authorization sensitive customer export",
          "facets": {"severity": "high", "provenance_trusted": true},
          "source_refs": [{"type": "path", "path": "apps/api/users.py:42"}]
        },
        {
          "source_type": "code_context",
          "item_type": "code_context",
          "title": "GET /v2/users/export",
          "body": "Route exports customer pii and missing authorization for tenant scope.",
          "facets": {"has_sensitive_signals": true, "has_authz": false},
          "source_refs": [{"type": "path", "path": "apps/api/users.py:42"}]
        }
      ],
      "expected": {
        "decision": "block",
        "scanner_only": false,
        "required_trace": ["material_sensitive_authz_signal:True"],
        "required_evidence": ["/v2/users/export", "customer pii"]
      }
    },
    {
      "id": "pii_export_after_authz_fix_passes",
      "name": "Same route after authz fix",
      "kind": "golden",
      "entries": [
        {
          "source_type": "code_context",
          "item_type": "code_context",
          "title": "GET /v2/users/export",
          "body": "Route exports customer pii with authorize(current_user, users:export) and tenant_id filter.",
          "facets": {"has_sensitive_signals": true, "has_authz": true, "tenant_scoped": true},
          "source_refs": [{"type": "path", "path": "apps/api/users.py:42"}]
        }
      ],
      "expected": {
        "allowed_decisions": ["pass", "fix"],
        "scanner_only": false,
        "required_trace": ["no_scanner_findings_pass"],
        "required_evidence": ["tenant_id filter"]
      }
    },
    {
      "id": "scanner_only_false_positive_unreachable_verify",
      "name": "Scanner-only false positive in unreachable code",
      "kind": "golden",
      "entries": [
        {
          "source_type": "scan_finding",
          "item_type": "scanner_finding",
          "title": "Unreachable demo export route is missing authorization",
          "body": "severity=high missing authorization sensitive export in unreachable demo code",
          "facets": {"severity": "high", "reachable": false, "provenance_trusted": true},
          "source_refs": [{"type": "path", "path": "examples/demo.py:12"}]
        }
      ],
      "expected": {
        "allowed_decisions": ["verify", "pass"],
        "scanner_only": true,
        "required_trace": ["scanner_only_high_requires_verification"]
      }
    },
    {
      "id": "sensitive_route_missing_cloud_exposure_verify",
      "name": "Sensitive route with missing cloud exposure",
      "kind": "golden",
      "entries": [
        {
          "source_type": "code_context",
          "item_type": "code_context",
          "title": "GET /v2/users/export",
          "body": "Sensitive customer export route has missing authorization but no ALB or gateway exposure evidence was indexed.",
          "facets": {"has_sensitive_signals": true, "has_authz": false, "exposure_evidence": "missing"},
          "source_refs": [{"type": "path", "path": "apps/api/users.py:42"}]
        }
      ],
      "expected": {
        "decision": "verify",
        "scanner_only": false,
        "required_trace": ["sensitive_authz_gap_missing_scanner_or_exposure"],
        "required_evidence": ["exposure evidence"]
      }
    },
    {
      "id": "metadata_only_gather_evidence",
      "name": "Metadata-only review",
      "kind": "golden",
      "entries": [
        {
          "source_type": "review",
          "item_type": "app_profile",
          "title": "Application profile",
          "body": "Customer says this is a fintech API, but no code, scanner, IaC, or docs evidence was indexed.",
          "facets": {"data_class": "pii"},
          "source_refs": [{"type": "review", "id": "metadata-only"}]
        }
      ],
      "expected": {
        "allowed_decisions": ["gather_evidence", "verify"],
        "scanner_only": false,
        "required_trace": ["metadata_only_requires_more_evidence"]
      }
    },
    {
      "id": "webhook_missing_signature_fix",
      "name": "Webhook route without signature verification",
      "kind": "golden",
      "entries": [
        {
          "source_type": "code_context",
          "item_type": "code_context",
          "title": "POST /webhooks/stripe",
          "body": "Webhook handler accepts payment events and webhook_signature_verification_not_identified.",
          "facets": {"route_kind": "webhook", "signature_verification": false},
          "source_refs": [{"type": "path", "path": "apps/api/webhooks.py:18"}]
        }
      ],
      "expected": {
        "allowed_decisions": ["fix", "block"],
        "scanner_only": false,
        "required_trace": ["webhook_signature_gap_requires_fix"]
      }
    },
    {
      "id": "iac_public_admin_blocks",
      "name": "IaC exposes admin service publicly",
      "kind": "golden",
      "safety_critical": true,
      "entries": [
        {
          "source_type": "document",
          "item_type": "control",
          "title": "Terraform ALB listener",
          "body": "IaC exposes public admin service on 0.0.0.0/0 through internet-facing ALB.",
          "facets": {"surface": "admin", "public_exposure": true, "iac": "terraform"},
          "source_refs": [{"type": "path", "path": "infra/admin.tf:28"}]
        }
      ],
      "expected": {
        "allowed_decisions": ["block", "fix"],
        "scanner_only": false,
        "required_trace": ["public_admin_iac_blocks_release"]
      }
    },
    {
      "id": "active_accepted_risk_monitored",
      "name": "Active accepted risk",
      "kind": "golden",
      "entries": [
        {
          "source_type": "scan_finding",
          "item_type": "scanner_finding",
          "title": "Legacy export route is missing authorization",
          "body": "severity=high missing authorization sensitive customer export",
          "facets": {"severity": "high", "provenance_trusted": true},
          "source_refs": [{"type": "path", "path": "legacy/export.py:42"}]
        },
        {
          "source_type": "manual",
          "item_type": "accepted_risk",
          "title": "Accepted risk active for legacy export",
          "body": "Accepted risk active for legacy export until 2026-07-01 with compensating monitoring.",
          "facets": {
            "acceptance_state": "active",
            "scope_type": "route",
            "scope_value": "legacy/export.py:42",
            "expires_at": "2026-07-01T00:00:00+00:00",
            "compensating_control_present": true
          },
          "source_refs": [{"type": "risk_acceptance", "id": "risk-1"}]
        }
      ],
      "expected": {
        "allowed_decisions": ["verify", "pass"],
        "scanner_only": false,
        "required_trace": ["active_risk_acceptance_scope_matches_all_high_findings"]
      }
    },
    {
      "id": "expired_accepted_risk_reopened",
      "name": "Expired accepted risk",
      "kind": "golden",
      "safety_critical": true,
      "entries": [
        {
          "source_type": "scan_finding",
          "item_type": "scanner_finding",
          "title": "Expired-risk export route is missing authorization",
          "body": "severity=high missing authorization sensitive customer export",
          "facets": {"severity": "high", "provenance_trusted": true},
          "source_refs": [{"type": "path", "path": "legacy/export.py:42"}]
        },
        {
          "source_type": "manual",
          "item_type": "accepted_risk",
          "title": "Accepted risk expired",
          "body": "Accepted risk expired on 2026-04-01.",
          "facets": {"acceptance_state": "expired", "expires_at": "2026-04-01"},
          "source_refs": [{"type": "risk_acceptance", "id": "risk-2"}]
        },
        {
          "source_type": "code_context",
          "item_type": "code_context",
          "title": "GET /legacy/export",
          "body": "Legacy route still reads sensitive customer pii and missing authorization.",
          "facets": {"has_sensitive_signals": true, "has_authz": false},
          "source_refs": [{"type": "path", "path": "legacy/export.py:42"}]
        }
      ],
      "expected": {
        "allowed_decisions": ["block", "fix"],
        "scanner_only": false,
        "required_trace": ["high_scanner_supported_by_context"]
      }
    },
    {
      "id": "conflicting_docs_code_verify",
      "name": "Conflicting docs and code",
      "kind": "golden",
      "entries": [
        {
          "source_type": "document",
