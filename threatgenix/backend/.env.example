# ThreatGenix self-hosted local defaults.
# Copy this file to .env before production use and replace every dev value.

APP_ENV=development
API_TITLE=ThreatGenix
RUNTIME_NAME=threatgenix
DEPLOYMENT_PROFILE=local

# Local Docker database. Use a managed Postgres URL for production.
DATABASE_URL=postgresql+asyncpg://threatgenix:password@localhost:5432/threatgenix
# DATABASE_SSL=require

# Required for production. The default only works in local development.
SECRET_KEY=dev-secret-change-in-production
ALLOWED_ORIGINS=http://localhost:5173
# Set in production to the public API host, for example api.example.com.
# Leave blank for local development and tests.
TRUSTED_HOSTS=

# AI provider. Ollama is the safest self-hosted default. Set LLM_PROVIDER to
# anthropic, openai, openrouter, gemini, xai, zai, perplexity, bedrock, or auto
# when you have configured the matching credentials.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# External provider credentials. Leave blank unless you explicitly opt in.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# XAI_API_KEY=
# ZAI_API_KEY=
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# ZAI_MODEL=glm-4.6
# PERPLEXITY_API_KEY=

# Threat-intel embeddings. The pgvector schema is Vector(1024), so alternate
# providers must return exactly 1024 dimensions.
EMBEDDING_PROVIDER=bedrock
# EMBEDDING_MODEL=
EMBEDDING_DIMENSION=1024
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=

# AWS Bedrock.
AWS_DEFAULT_REGION=ca-central-1
BEDROCK_REGION=ca-central-1
BEDROCK_MODEL_ID=ca.amazon.nova-lite-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Keep report/review endpoints deterministic unless semantic retrieval is
# deliberately configured.
SECURITY_REVIEW_SEMANTIC_INTEL_ENABLED=false
ALLOW_EXTERNAL_AI_PROVIDERS_IN_PRODUCTION=false

# Optional integrations.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_BASE64=
# GITHUB_WEBHOOK_SECRET=
REMEDIATION_WEBHOOK_SIGNATURE_SECRET=

# Validation runner defaults. Local installs are parse/import first; live scanner
# execution should only be enabled on trusted self-hosted runner machines.
THREATGENIX_VALIDATION_RUNTIME_MODE=try_sandbox
THREATGENIX_VALIDATION_MANAGED_RUNNER_ENABLED=false
THREATGENIX_VALIDATION_ALLOWED_PATHS=
THREATGENIX_VALIDATION_SEMGREP_ENABLED=true
THREATGENIX_VALIDATION_OSV_SCANNER_ENABLED=true
THREATGENIX_VALIDATION_TRIVY_ENABLED=true
THREATGENIX_VALIDATION_CHECKOV_ENABLED=true
THREATGENIX_VALIDATION_TRUFFLEHOG_ENABLED=true
THREATGENIX_VALIDATION_SANDBOX_MODE=process
THREATGENIX_VALIDATION_CONTAINER_RUNTIME=docker
THREATGENIX_VALIDATION_CONTAINER_CPUS=1
THREATGENIX_VALIDATION_CONTAINER_MEMORY=1g
THREATGENIX_VALIDATION_CONTAINER_PIDS=256
THREATGENIX_VALIDATION_CONTAINER_PULL=never
THREATGENIX_VALIDATION_SCHEDULER_ENABLED=false
THREATGENIX_VALIDATION_SCHEDULER_RUN_INLINE=false

VALIDATION_WORKER_HEARTBEAT_INTERVAL=10
VALIDATION_WORKER_LEASE_SECONDS=90
VALIDATION_WORKER_MAX_ATTEMPTS=3
VALIDATION_WORKER_HEARTBEAT_FRESH_SECONDS=45
VALIDATION_ARTIFACT_BUNDLE_MAX_BYTES=15000000
VALIDATION_ARTIFACT_BUNDLE_MAX_ITEMS=20

PDF_MAX_PAGES=30
